# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# claude code worktrees (agent sandboxes, not project code)
.claude/worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Masters for the payoff shot, kept locally so a re-cut never needs another
# recording or render session. What ships is beside them: the transcoded
# phone-*.mp4 clips and the table-*.webp stills. These are ignored rather than
# committed because public/ serves whatever is in it — 12MB of H.265 no browser
# on the site would play, and 12MB of PNG nothing points at.
/public/marketing/goals.MP4
/public/marketing/story.MP4
/public/marketing/goals-and-story-portrait.png
/public/marketing/goals-and-story.png
